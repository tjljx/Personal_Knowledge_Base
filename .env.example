# Source mode: set an independent random JWT_SECRET before use.
DATABASE_URL=sqlite+pysqlite:///./data/knowledge.db
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:5173
STORAGE_ROOT=data/files
MAX_UPLOAD_BYTES=52428800
SESSION_IDLE_MINUTES=10

# Optional cloud gateway. Knowledge bases disallow cloud calls by default.
MODEL_PROVIDER=example
MODEL_API_KEY=
MODEL_BASE_URL=https://example.invalid/v1
MODEL_NAME=example-model
MODEL_INPUT_CNY_PER_MILLION=
MODEL_OUTPUT_CNY_PER_MILLION=
CLOUD_MONTHLY_BUDGET_CNY=200

# Optional local retrieval services.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=http://127.0.0.1:11434
VECTOR_STORE_URL=
RERANK_BASE_URL=
