# Copy to .env.selfhost. Use a new random hexadecimal value for both password fields.
POSTGRES_PASSWORD=replace_with_random_hex
DATABASE_URL=postgresql+psycopg://knowledge:replace_with_random_hex@db:5432/knowledge
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PKB_BIND_ADDRESS=127.0.0.1
PKB_WEB_PORT=8765
CORS_ORIGINS=http://127.0.0.1:8765
MAX_UPLOAD_BYTES=52428800
SESSION_IDLE_MINUTES=10

# Cloud calls remain disabled per knowledge base until an administrator enables them.
# Configure a compatible model gateway and both price fields before enabling cloud use.
MODEL_PROVIDER=example
MODEL_API_KEY=
MODEL_BASE_URL=https://example.invalid/v1
MODEL_NAME=example-model
MODEL_TIMEOUT_SECONDS=45
MODEL_INPUT_CNY_PER_MILLION=
MODEL_OUTPUT_CNY_PER_MILLION=
MODEL_MAX_OUTPUT_TOKENS=2048
CLOUD_MONTHLY_BUDGET_CNY=200

EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_EXPECTED_DIMENSIONS=1024
EMBEDDING_MIN_SIMILARITY=0.5
EMBEDDING_QUERY_INSTRUCTION=
VECTOR_STORE_COLLECTION=personal_knowledge_chunks_v1
RERANK_TIMEOUT_SECONDS=20
RERANK_CANDIDATE_LIMIT=12
